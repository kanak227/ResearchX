# ResearchX Environment Configuration Example
APP_NAME=ResearchX
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage Paths
DATA_DIR=data
UPLOADS_DIR=data/uploads
EXTRACTED_DIR=data/extracted
SQLITE_DB_PATH=data/researchx.db
QDRANT_STORAGE_PATH=data/qdrant

# Models & Inference
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_FALLBACK_MODEL=llama3.2:1b
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
ENABLE_VLM=false
VLM_MODEL_NAME=moondream

# Retrieval Configuration Defaults
DEFAULT_RETRIEVAL_MODE=multimodal
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.35
BM25_WEIGHT=0.35
DENSE_WEIGHT=0.65

